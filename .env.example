# Copy to .env in the repo root. Read by the CLI in dev (`pnpm dev ...`) through dotenv.

# Anthropic API key for analysis. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Claude model for analysis (default claude-sonnet-5-5).
# OPHAN_MODEL=claude-opus-5-5

# Optional: the Ophan server for `pnpm dev login` / `sync` against a local webapp.
# OPHAN_SERVER_URL=http://localhost:3000
