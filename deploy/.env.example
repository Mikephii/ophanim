# Ophan server configuration. Copy to deploy/.env and fill in.
# All values come from your Supabase project: Dashboard -> Project Settings -> API
# (or `supabase status` for a local stack).

# How the webapp server reaches Supabase.
SUPABASE_URL=https://your-project.supabase.co

# The public anon key. Safe to share: browsers and the CLI receive it.
SUPABASE_ANON_KEY=

# The service role key. Server only: used to mint CLI sign-in tokens. Never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the Supabase URL browsers and CLIs should use, when it differs from SUPABASE_URL
# (e.g. the webapp reaches Supabase on a Docker network name, clients on a public hostname).
# SUPABASE_PUBLIC_URL=https://supabase.example.com

# Host port for the webapp (default 3000).
# OPHAN_PORT=3000
