// Generates THIRD_PARTY_NOTICES.md from the dependencies that ship inside Ophan's artifacts:
// the CLI and extension bundles (esbuild bundles their devDependencies too), the webview, and the
// webapp image. Build and test tooling is left out. Run after changing dependencies: pnpm notices
import { execFileSync } from "node:child_process";
import { existsSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join, resolve } from "node:path";

const ROOT = resolve(import.meta.dirname, "..");
type Node = { version: string; path: string; dependencies?: Record<string, Node> };
type Project = { name: string; dependencies?: Record<string, Node>; devDependencies?: Record<string, Node> };
const tree = JSON.parse(
  execFileSync("pnpm", ["ls", "-r", "--json", "--depth", "Infinity"], { cwd: ROOT, encoding: "utf8", maxBuffer: 512 * 1024 * 1024 })
) as Project[];

// Tools that run at build or test time and never end up in a shipped artifact.
const TOOLING = /^(@types\/|typescript$|vitest|@vitest\/|esbuild$|tsx$|vite$|@vitejs\/|vite-|eslint|@eslint\/|prettier|@testing-library\/|jsdom$|@vscode\/vsce|@vscode\/test|@electron\/rebuild|@tanstack\/devtools-vite|@tanstack\/eslint|dotenv$|happy-dom|web-vitals)/;

const pkgs = new Map<string, { name: string; version: string; path: string }>();
const walk = (deps: Record<string, Node> | undefined) => {
  for (const [name, n] of Object.entries(deps ?? {})) {
    if (!n.path || n.version.startsWith("link:") || name.startsWith("@ophan/")) continue;
    // Optional platform packages that aren't installed here aren't shipped from here either.
    if (!existsSync(join(n.path, "package.json"))) continue;
    const key = `${name}@${n.version}`;
    if (pkgs.has(key)) continue;
    pkgs.set(key, { name, version: n.version, path: n.path });
    walk(n.dependencies);
  }
};
const topLevel = (deps: Record<string, Node> | undefined) =>
  Object.fromEntries(Object.entries(deps ?? {}).filter(([name]) => !TOOLING.test(name)));
for (const p of tree) {
  if (p.name === "ophan-monorepo") continue;
  walk(topLevel(p.dependencies));
  walk(topLevel(p.devDependencies));
}

const licenseText = (dir: string) => {
  const f = existsSync(dir) ? readdirSync(dir).find((x) => /^(licen[sc]e|copying)(\.|$|-)/i.test(x)) : undefined;
  return f ? readFileSync(join(dir, f), "utf8").trim() : null;
};
const rows = [...pkgs.values()].sort((a, b) => a.name.localeCompare(b.name) || a.version.localeCompare(b.version)).map((p) => {
  const pj = JSON.parse(readFileSync(join(p.path, "package.json"), "utf8"));
  const license = typeof pj.license === "string" ? pj.license : pj.license?.type ?? (Array.isArray(pj.licenses) ? pj.licenses.map((l: { type: string }) => l.type).join(" OR ") : "UNKNOWN");
  const repo = typeof pj.repository === "string" ? pj.repository : pj.repository?.url ?? pj.homepage ?? "";
  return { ...p, license, repo: String(repo).replace(/^git\+/, "").replace(/\.git$/, ""), text: licenseText(p.path) };
});

const counts = new Map<string, number>();
for (const r of rows) counts.set(r.license, (counts.get(r.license) ?? 0) + 1);

let out = `# Third-party notices

Generated by \`pnpm notices\` (scripts/third-party-notices.mts) from the dependencies bundled into the
CLI, the VS Code extension, the webview and the webapp image. Do not edit by hand.

## Native and bundled programs

| Program | Licence | Source | How it is used |
|---|---|---|---|
| SQLite | Public domain | https://sqlite.org/copyright.html | compiled into better-sqlite3's native module, shipped in the extension and installed with the CLI |

## npm packages (${rows.length})

Licences: ${[...counts].sort((a, b) => b[1] - a[1]).map(([l, n]) => `${l} ${n}`).join(", ")}.

| Package | Version | Licence | Source |
|---|---|---|---|
${rows.map((r) => `| ${r.name} | ${r.version} | ${r.license} | ${r.repo} |`).join("\n")}

## Licence texts

`;
for (const r of rows) out += `### ${r.name}@${r.version} (${r.license})\n\n${r.text ? "```\n" + r.text.replace(/```/g, "'''") + "\n```" : "No licence file is shipped in the package; see its package.json and source."}\n\n`;
writeFileSync(join(ROOT, "THIRD_PARTY_NOTICES.md"), out);
console.log(`THIRD_PARTY_NOTICES.md: ${rows.length} packages; licences ${[...counts].map(([l, n]) => `${l}=${n}`).join(", ")}`);
